[Unit]
Description=Telegram Bot Proxy
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=tg-bot-proxy
Group=tg-bot-proxy
WorkingDirectory=/opt/tg-bot-proxy
EnvironmentFile=/etc/tg-bot-proxy/secrets.env
ExecStart=/opt/tg-bot-proxy/current/tg-bot-proxy
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
